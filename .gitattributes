# Normalize line endings: store as LF, checkout as-is on each platform
* text=auto eol=lf

# Force binary files to never be text-processed
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.apk binary
*.aab binary
*.jar binary
*.class binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.zip binary
*.tar.gz binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
