# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get this from https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.neon.tech/hisaab?sslmode=require"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_random_64_char_hex_string
JWT_REFRESH_SECRET=change_me_to_a_different_random_64_char_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Encryption (AES-256-GCM) ─────────────────────────────────────────────────
# MUST be exactly 32 bytes (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_SECRET=change_me_to_a_64_hex_char_random_string_generated_with_crypto

# ─── Brevo (Email) ────────────────────────────────────────────────────────────
# Get your API key from https://app.brevo.com → Settings → API Keys
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@hisaab.app
BREVO_SENDER_NAME=Hisaab

# ─── App URLs ─────────────────────────────────────────────────────────────────
# Used in email links (set to your Render URL in production)
APP_URL=http://localhost:3000
CLIENT_DEEP_LINK=hisaab://
FRONTEND_URL=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max requests per IP per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
